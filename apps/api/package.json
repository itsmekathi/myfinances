{
  "name": "@myfinances/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "seed:subcategories": "ts-node -T scripts/seed-subcategories.ts"
  },
  "dependencies": {
    "@myfinances/shared": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "bowser": "^2.15.0",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.3.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
