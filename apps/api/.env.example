NODE_ENV=development
PORT=3000
# Local PostgreSQL (password set during install)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/myfinances?schema=public"
# Hosted only: direct (non-pooled) URL for `prisma migrate`. Falls back to DATABASE_URL.
# DIRECT_DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated Google OAuth client IDs (web, android, ios) allowed as ID-token audience
GOOGLE_CLIENT_IDS=
WEB_ORIGIN=http://localhost:5173
# Proxy hops in front of the API, counting the socket peer (0 locally, 3 on Render).
# See GET /api/health/client-ip and deployment/setup-guide.md.
TRUST_PROXY_HOPS=0
DEFAULT_CURRENCY=INR
# Attachment storage: local (default) or s3 (Cloudflare R2 / any S3-compatible bucket)
STORAGE_DRIVER=local
# local driver: folder for uploaded attachments (relative to apps/api)
STORAGE_DIR=storage
# s3 driver: all four of endpoint/bucket/keys are required when STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=myfinances-attachments-prod
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
