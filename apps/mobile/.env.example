# The API must be reachable from the phone/emulator:
#  - Android emulator: http://10.0.2.2:3000/api
#  - Physical phone on the same Wi-Fi: http://<your-PC-LAN-IP>:3000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Google Sign-In (needs a development build, not Expo Go).
# WEB client ID is what makes Google return an ID token; it must also be in the API's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
