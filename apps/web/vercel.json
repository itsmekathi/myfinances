{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter \"@myfinances/web...\"",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@myfinances/web...",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://myfinances-api-0km5.onrender.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-proxy-secret"
          },
          "args": "$PROXY_SECRET",
          "env": [
            "PROXY_SECRET"
          ]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
