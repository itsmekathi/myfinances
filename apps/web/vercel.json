{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter \"@myfinances/web...\"",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@myfinances/web...",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": false },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://myfinances-api.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
