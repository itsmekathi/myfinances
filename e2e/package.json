{
  "name": "@myfinances/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end suites (api + ui) that run against local, staging or production.",
  "scripts": {
    "pw": "playwright test",
    "pw:api": "playwright test --project=api",
    "pw:ui": "playwright test --project=ui",
    "pw:report": "playwright show-report playwright-report",
    "install-browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@myfinances/shared": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9"
  }
}
