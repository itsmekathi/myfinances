# Copy to e2e/.env (gitignored). Every value is optional.

# local (default) | staging | production
E2E_TARGET=local

# Override the target's URLs, e.g. to test a specific Vercel preview deployment.
# E2E_WEB_URL=https://myfinances-gamma-staging.vercel.app
# E2E_API_URL=https://myfinances-api-staging.onrender.com

# Staging web is behind Vercel Authentication. Vercel → Settings → Deployment Protection
# → Protection Bypass for Automation gives this secret.
# VERCEL_AUTOMATION_BYPASS_SECRET=
